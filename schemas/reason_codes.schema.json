{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.trading-system/schemas/reason_codes.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "codes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "3.0.0"},
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "category", "criticality", "fail_action"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
          "category": {"type": "string", "minLength": 1},
          "criticality": {"type": "string", "minLength": 1},
          "fail_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
