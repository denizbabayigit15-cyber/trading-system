{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.trading-system/schemas/question_relations.schema.json",
  "type": "object",
  "required": ["contract_version", "relations", "evidence_independence_rule"],
  "properties": {
    "contract_version": {"const": "3.0.0"},
    "relations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["question_ids", "relation", "rule_tr"], "properties": {"question_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2,3}-[0-9]{3}$"}}, "relation": {"enum": ["INTENTIONAL_CROSS_CONTROL", "NESTED_REQUIREMENT", "DEFENSE_IN_DEPTH"]}, "rule_tr": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "evidence_independence_rule": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
