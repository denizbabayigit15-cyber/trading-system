{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.trading-system/schemas/event_envelope.schema.json",
  "title": "Canonical Event Envelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "schema_version",
    "occurred_at",
    "produced_at",
    "producer",
    "correlation_id",
    "payload",
    "payload_sha256"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{32}$"},
    "event_type": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.(succeeded|failed)\\.v[0-9]+$"},
    "event_version": {"type": "integer", "minimum": 1},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "produced_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "decision_id": {"type": ["string", "null"]},
    "lineage_id": {"type": ["string", "null"]},
    "scope_hash": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

